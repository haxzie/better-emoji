---
import Base from '../layouts/Base.astro';
---

<Base title="Not found — Better Emoji" description="That page doesn't exist." path="/404">
  <article class="doc">
    <header class="doc-head">
      <p class="eyebrow">404</p>
      <h1>🫥 Nothing here</h1>
      <p class="lede">Try the <a href="/">search</a>, the <a href="/api">API docs</a>, or <a href="/download">download the app</a>.</p>
    </header>
  </article>
</Base>
