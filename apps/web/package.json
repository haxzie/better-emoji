{
  "name": "@emoji-search/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-assets.mjs",
    "predev": "node scripts/sync-assets.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/sync-assets.mjs",
    "build": "astro build",
    "build:cf": "pnpm -w index:fetch-model && pnpm -w build --filter=@emoji-search/web",
    "preview": "astro preview",
    "dev:worker": "pnpm build && wrangler dev",
    "typecheck": "astro sync && tsc -p . && tsc -p server",
    "ship": "pnpm build && wrangler deploy",
    "clean": "rm -rf dist .turbo .wrangler"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@cloudflare/workers-types": "^5.20260914.1",
    "@emoji-search/index": "workspace:*",
    "astro": "^7.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.131.1"
  }
}
