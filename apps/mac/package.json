{
  "name": "@emoji-search/mac",
  "version": "0.1.0",
  "private": true,
  "description": "macOS menu bar emoji picker with on-device semantic search",
  "scripts": {
    "bundle": "scripts/bundle.sh",
    "open": "scripts/bundle.sh && open 'build/Better Emoji.app'",
    "probe": "swift build -c release 2>/dev/null && .build/release/EmojiSearch --probe"
  },
  "devDependencies": {
    "@emoji-search/index": "workspace:*"
  }
}
